---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
  page?: string
}

const {
  title,
  description = 'OnFire Systems — Infraestructura robusta, arquitectura escalable y software a la medida para empresas colombianas. 7 años construyendo tecnología que no se detiene.',
  ogImage = '/og-default.svg',
  page
} = Astro.props

const SITE = 'https://onfiresystems.co'
const canonicalURL = new URL(Astro.url.pathname, SITE)
const ogImageURL = new URL(ogImage, SITE)

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": `${SITE}/#organization`,
      "name": "OnFire Systems",
      "url": SITE,
      "logo": `${SITE}/favicon.svg`,
      "description": "Empresa colombiana de tecnología especializada en infraestructura, seguridad de redes, arquitectura de software, desarrollo a la medida y domótica IoT.",
      "foundingDate": "2018",
      "areaServed": "CO",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO",
        "addressRegion": "Colombia"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "hola@onfiresystems.co",
        "availableLanguage": "Spanish"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "OnFire Systems",
      "publisher": { "@id": `${SITE}/#organization` }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.href}#webpage`,
      "url": canonicalURL.href,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "es-CO"
    }
  ]
})
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#090909" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="author" content="OnFire Systems" />
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Geo targeting Colombia -->
  <meta name="geo.region" content="CO" />
  <meta name="geo.placename" content="Colombia" />
  <meta name="language" content="Spanish" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content="OnFire Systems" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="OnFire Systems — Tecnología empresarial" />
  <meta property="og:locale" content="es_CO" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.href} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts — preconnect primero, luego la hoja de estilos -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <div class="color-bar"></div>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <nav>
    <a href="/" class="logo">
      <div class="logo-bar"></div>
      <div class="logo-text">
        <span class="t1">on</span><span class="t2">fire</span>
        <span class="t6">systems</span>
      </div>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="/servicios" class={page === 'servicios' ? 'active' : ''}>Servicios</a></li>
      <li><a href="/nosotros" class={page === 'nosotros' ? 'active' : ''}>Nosotros</a></li>
      <li><a href="/proceso" class={page === 'proceso' ? 'active' : ''}>Proceso</a></li>
      <li><a href="/contacto" class={`nav-cta${page === 'contacto' ? ' active' : ''}`}>Contáctenos</a></li>
    </ul>
  </nav>

  <slot />

  <footer>
    <p class="footer-copy">© 2025 OnFire Systems — 7 años construyendo tecnología. Todos los derechos reservados.</p>
    <div class="footer-links">
      <a href="/" class={page === 'home' ? 'active' : ''}>Inicio</a>
      <a href="#" target="_blank" rel="noopener">LinkedIn</a>
      <a href="#" target="_blank" rel="noopener">GitHub</a>
    </div>
  </footer>

  <script>
    const cursor = document.getElementById('cursor')!
    const ring = document.getElementById('cursorRing')!
    let mx = 0, my = 0, rx = 0, ry = 0
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY
      cursor.style.left = mx + 'px'
      cursor.style.top = my + 'px'
    })
    ;(function loop() {
      rx += (mx - rx) * 0.12
      ry += (my - ry) * 0.12
      ring.style.left = rx + 'px'
      ring.style.top = ry + 'px'
      requestAnimationFrame(loop)
    })()
    document.querySelectorAll('.reveal').forEach(el =>
      new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible') })
      }, { threshold: 0.08 }).observe(el)
    )

    const navToggle = document.getElementById('navToggle')!
    const navLinks = document.getElementById('navLinks')!
    navToggle.addEventListener('click', () => {
      navToggle.classList.toggle('open')
      navLinks.classList.toggle('open')
      document.body.style.overflow = navLinks.classList.contains('open') ? 'hidden' : ''
    })
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navToggle.classList.remove('open')
        navLinks.classList.remove('open')
        document.body.style.overflow = ''
      })
    })
  </script>
</body>
</html>

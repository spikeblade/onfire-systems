---
import { getCookieToken, supabaseWithToken } from '../../lib/supabase'

const token = getCookieToken(Astro.request.headers.get('cookie'))
if (!token) return Astro.redirect('/admin/login')
const client = supabaseWithToken(token)
const { data: { user } } = await client.auth.getUser()
if (!user) return Astro.redirect('/admin/login')

const { data: rows } = await client.from('page_content').select('*').order('page').order('section').order('key')

const pages = ['home', 'servicios', 'nosotros', 'proceso', 'contacto']
const pageNames: Record<string, string> = { home: 'Inicio', servicios: 'Servicios', nosotros: 'Nosotros', proceso: 'Proceso', contacto: 'Contacto' }

type Row = { id: string; page: string; section: string; key: string; value: string }
const byPage: Record<string, Record<string, Row[]>> = {}
for (const row of (rows ?? []) as Row[]) {
  if (!byPage[row.page]) byPage[row.page] = {}
  if (!byPage[row.page][row.section]) byPage[row.page][row.section] = []
  byPage[row.page][row.section].push(row)
}
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contenido — OnFire Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
  <style>
    :root{--black:#090909;--white:#f5f5f0;--red:#e8231a;--yellow:#f5a800;--green:#3a9e2f;--blue:#1a5bbf;--gray:#1a1a1a;--gray2:#2a2a2a;--muted:#666}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;font-weight:300;min-height:100vh;display:flex}
    .sidebar{width:240px;background:var(--gray);padding:32px 24px;display:flex;flex-direction:column;flex-shrink:0;border-right:1px solid var(--gray2)}
    .sidebar-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;margin-bottom:48px}
    .sidebar-logo span{color:var(--red)}
    .nav-item{display:block;padding:12px 16px;color:var(--muted);text-decoration:none;font-size:0.85rem;border-radius:2px;margin-bottom:4px;transition:all 0.2s}
    .nav-item:hover,.nav-item.active{background:var(--gray2);color:var(--white)}
    .nav-item.active{color:var(--yellow)}
    .sidebar-footer{margin-top:auto}
    .logout-btn{width:100%;background:none;border:1px solid var(--gray2);color:var(--muted);padding:10px;font-family:'DM Sans',sans-serif;font-size:0.8rem;border-radius:2px;cursor:pointer;transition:all 0.2s;text-align:center}
    .logout-btn:hover{border-color:var(--red);color:var(--red)}
    .main{flex:1;padding:48px;overflow:auto}
    .page-header{margin-bottom:40px}
    .page-header h1{font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;margin-bottom:8px}
    .page-header p{color:var(--muted);font-size:0.875rem}
    .page-tabs{display:flex;gap:2px;margin-bottom:32px;flex-wrap:wrap}
    .tab{padding:10px 20px;background:var(--gray);color:var(--muted);font-size:0.8rem;font-weight:500;cursor:pointer;border:none;border-radius:2px;transition:all 0.2s;font-family:'DM Sans',sans-serif}
    .tab:hover{background:var(--gray2);color:var(--white)}
    .tab.active{background:var(--red);color:var(--white)}
    .page-content{display:none}
    .page-content.active{display:block}
    .section-block{background:var(--gray);margin-bottom:2px;padding:28px 32px}
    .section-title{font-family:'Syne',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;display:flex;align-items:center;gap:10px}
    .section-title::before{content:'';width:16px;height:1px;background:currentColor}
    .field-row{display:grid;grid-template-columns:180px 1fr auto;gap:12px;align-items:start;margin-bottom:12px}
    .field-key{font-size:0.75rem;color:var(--muted);padding-top:10px;letter-spacing:0.05em}
    .field-input{background:var(--black);border:1px solid var(--gray2);color:var(--white);padding:10px 14px;font-family:'DM Sans',sans-serif;font-size:0.875rem;border-radius:2px;outline:none;transition:border-color 0.2s;resize:vertical;min-height:40px}
    .field-input:focus{border-color:var(--yellow)}
    .save-btn{background:none;border:1px solid var(--gray2);color:var(--muted);padding:8px 16px;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;border-radius:2px;transition:all 0.2s;white-space:nowrap;align-self:start;margin-top:1px}
    .save-btn:hover{border-color:var(--green);color:var(--green)}
    .save-btn.saving{opacity:0.5;pointer-events:none}
    .save-btn.saved{border-color:var(--green);color:var(--green)}
    .toast{position:fixed;bottom:32px;right:32px;background:var(--green);color:var(--white);padding:12px 20px;border-radius:2px;font-size:0.85rem;font-weight:500;opacity:0;transition:opacity 0.3s;pointer-events:none;z-index:999}
    .toast.show{opacity:1}
    .empty-note{color:var(--muted);font-size:0.875rem;padding:16px 0}
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-logo"><span>on</span>fire admin</div>
    <a href="/admin" class="nav-item">Dashboard</a>
    <a href="/admin/contenido" class="nav-item active">Contenido</a>
    <a href="/admin/leads" class="nav-item">Leads</a>
    <a href="/" target="_blank" class="nav-item">Ver sitio →</a>
    <div class="sidebar-footer">
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="logout-btn">Cerrar sesión</button>
      </form>
    </div>
  </aside>

  <main class="main">
    <div class="page-header">
      <h1>Contenido</h1>
      <p>Edita los textos del sitio. Los cambios se reflejan al guardar y recargar la página.</p>
    </div>

    <div class="page-tabs">
      {pages.map((pg, i) => (
        <button class={`tab${i === 0 ? ' active' : ''}`} data-page={pg} onclick={`switchPage('${pg}')`}>{pageNames[pg]}</button>
      ))}
    </div>

    {pages.map((pg, i) => (
      <div id={`page-${pg}`} class={`page-content${i === 0 ? ' active' : ''}`}>
        {byPage[pg] ? Object.entries(byPage[pg]).map(([sec, fields]) => (
          <div class="section-block">
            <div class="section-title">{sec}</div>
            {(fields as Row[]).map(field => (
              <div class="field-row">
                <span class="field-key">{field.key}</span>
                <textarea
                  class="field-input"
                  data-page={pg}
                  data-section={sec}
                  data-key={field.key}
                  rows={field.value.length > 80 ? 3 : 1}
                >{field.value}</textarea>
                <button class="save-btn" onclick="saveField(this)">Guardar</button>
              </div>
            ))}
          </div>
        )) : (
          <div class="section-block"><p class="empty-note">No hay contenido editable para esta página aún.</p></div>
        )}
      </div>
    ))}
  </main>

  <div class="toast" id="toast">✓ Guardado</div>

  <script is:inline>
    function switchPage(page) {
      document.querySelectorAll('.page-content').forEach(function(el) { el.classList.remove('active') })
      document.querySelectorAll('.tab').forEach(function(el) { el.classList.remove('active') })
      var content = document.getElementById('page-' + page)
      if (content) content.classList.add('active')
      document.querySelectorAll('.tab').forEach(function(btn) {
        if (btn.dataset.page === page) btn.classList.add('active')
      })
    }

    async function saveField(btn) {
      var row = btn.parentElement
      var textarea = row.querySelector('textarea')
      var page = textarea.dataset.page
      var section = textarea.dataset.section
      var key = textarea.dataset.key

      btn.classList.add('saving')
      btn.textContent = '...'

      try {
        var res = await fetch('/api/admin/content', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ page: page, section: section, key: key, value: textarea.value }),
        })
        btn.classList.remove('saving')
        if (res.ok) {
          btn.classList.add('saved')
          btn.textContent = '✓'
          showToast()
          setTimeout(function() { btn.classList.remove('saved'); btn.textContent = 'Guardar' }, 2000)
        } else {
          btn.textContent = 'Error'
          setTimeout(function() { btn.textContent = 'Guardar' }, 2000)
        }
      } catch (e) {
        btn.classList.remove('saving')
        btn.textContent = 'Error'
        setTimeout(function() { btn.textContent = 'Guardar' }, 2000)
      }
    }

    function showToast() {
      var toast = document.getElementById('toast')
      toast.classList.add('show')
      setTimeout(function() { toast.classList.remove('show') }, 2500)
    }
  </script>
</body>
</html>

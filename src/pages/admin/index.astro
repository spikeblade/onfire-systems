---
import { getCookieToken, supabaseWithToken } from '../../lib/supabase'

const token = getCookieToken(Astro.request.headers.get('cookie'))
if (!token) return Astro.redirect('/admin/login')
const client = supabaseWithToken(token)
const { data: { user } } = await client.auth.getUser()
if (!user) return Astro.redirect('/admin/login')

const { count: totalLeads } = await client.from('leads').select('*', { count: 'exact', head: true })
const { count: unreadLeads } = await client.from('leads').select('*', { count: 'exact', head: true }).eq('read', false)
const { data: recentLeads } = await client.from('leads').select('name,email,company,created_at').order('created_at', { ascending: false }).limit(5)
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — OnFire Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
  <style>
    :root{--black:#090909;--white:#f5f5f0;--red:#e8231a;--yellow:#f5a800;--green:#3a9e2f;--blue:#1a5bbf;--gray:#1a1a1a;--gray2:#2a2a2a;--muted:#666}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;font-weight:300;min-height:100vh;display:flex}
    .sidebar{width:240px;background:var(--gray);padding:32px 24px;display:flex;flex-direction:column;flex-shrink:0;border-right:1px solid var(--gray2)}
    .sidebar-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;margin-bottom:48px;color:var(--white)}
    .sidebar-logo span{color:var(--red)}
    .nav-item{display:block;padding:12px 16px;color:var(--muted);text-decoration:none;font-size:0.85rem;border-radius:2px;margin-bottom:4px;transition:all 0.2s}
    .nav-item:hover,.nav-item.active{background:var(--gray2);color:var(--white)}
    .nav-item.active{color:var(--yellow)}
    .sidebar-footer{margin-top:auto}
    .logout-btn{width:100%;background:none;border:1px solid var(--gray2);color:var(--muted);padding:10px;font-family:'DM Sans',sans-serif;font-size:0.8rem;border-radius:2px;cursor:pointer;transition:all 0.2s;text-align:center}
    .logout-btn:hover{border-color:var(--red);color:var(--red)}
    .main{flex:1;padding:48px;overflow:auto}
    .page-header{margin-bottom:48px}
    .page-header h1{font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;margin-bottom:8px}
    .page-header p{color:var(--muted);font-size:0.875rem}
    .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-bottom:48px}
    .stat-card{background:var(--gray);padding:32px;position:relative;overflow:hidden}
    .stat-accent{position:absolute;top:0;left:0;right:0;height:2px}
    .stat-label{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);font-weight:500;margin-bottom:12px}
    .stat-val{font-family:'Syne',sans-serif;font-size:3rem;font-weight:800;line-height:1}
    .table-wrap{background:var(--gray);padding:32px}
    .table-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
    .table-header h2{font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:700}
    .table-header a{font-size:0.8rem;color:var(--yellow);text-decoration:none}
    table{width:100%;border-collapse:collapse}
    th{font-size:0.68rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);font-weight:500;text-align:left;padding:12px 0;border-bottom:1px solid var(--gray2)}
    td{padding:16px 0;border-bottom:1px solid var(--gray2);font-size:0.875rem;color:rgba(245,245,240,0.7)}
    td:first-child{color:var(--white);font-weight:400}
    tr:last-child td{border-bottom:none}
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-logo"><span>on</span>fire admin</div>
    <a href="/admin" class="nav-item active">Dashboard</a>
    <a href="/admin/contenido" class="nav-item">Contenido</a>
    <a href="/admin/leads" class="nav-item">Leads</a>
    <a href="/" target="_blank" class="nav-item">Ver sitio →</a>
    <div class="sidebar-footer">
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="logout-btn">Cerrar sesión</button>
      </form>
    </div>
  </aside>

  <main class="main">
    <div class="page-header">
      <h1>Dashboard</h1>
      <p>Bienvenido, {user.email}</p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-accent" style="background:var(--red)"></div>
        <p class="stat-label">Total leads</p>
        <p class="stat-val" style="color:var(--red)">{totalLeads ?? 0}</p>
      </div>
      <div class="stat-card">
        <div class="stat-accent" style="background:var(--yellow)"></div>
        <p class="stat-label">Sin leer</p>
        <p class="stat-val" style="color:var(--yellow)">{unreadLeads ?? 0}</p>
      </div>
      <div class="stat-card">
        <div class="stat-accent" style="background:var(--green)"></div>
        <p class="stat-label">Leídos</p>
        <p class="stat-val" style="color:var(--green)">{(totalLeads ?? 0) - (unreadLeads ?? 0)}</p>
      </div>
    </div>

    <div class="table-wrap">
      <div class="table-header">
        <h2>Últimos mensajes</h2>
        <a href="/admin/leads">Ver todos →</a>
      </div>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Empresa</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          {recentLeads?.map(lead => (
            <tr>
              <td>{lead.name}</td>
              <td>{lead.email}</td>
              <td>{lead.company || '—'}</td>
              <td>{new Date(lead.created_at).toLocaleDateString('es-CO')}</td>
            </tr>
          ))}
          {(!recentLeads || recentLeads.length === 0) && (
            <tr><td colspan="4" style="color:var(--muted);text-align:center;padding:40px 0">Aún no hay mensajes</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>

---
import { getCookieToken, supabaseWithToken } from '../../lib/supabase'

const token = getCookieToken(Astro.request.headers.get('cookie'))
if (token) {
  const client = supabaseWithToken(token)
  const { data: { user } } = await client.auth.getUser()
  if (user) return Astro.redirect('/admin')
}

const hasError = Astro.url.searchParams.get('error') === '1'
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — OnFire Systems</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
  <style>
    :root { --black:#090909;--white:#f5f5f0;--red:#e8231a;--yellow:#f5a800;--gray:#1a1a1a;--gray2:#2a2a2a;--muted:#666; }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    body { background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;font-weight:300;min-height:100vh;display:flex;align-items:center;justify-content:center; }
    .login-box { width:100%;max-width:420px;padding:24px; }
    .login-logo { font-family:'Syne',sans-serif;font-weight:800;font-size:1.4rem;margin-bottom:48px; }
    .login-logo .r{color:var(--red)} .login-logo .y{color:var(--yellow)}
    h1 { font-family:'Syne',sans-serif;font-size:1.8rem;font-weight:800;margin-bottom:8px; }
    p.sub { font-size:0.875rem;color:var(--muted);margin-bottom:40px; }
    .field { display:flex;flex-direction:column;gap:8px;margin-bottom:16px; }
    label { font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;color:var(--muted); }
    input { background:var(--gray);border:1px solid var(--gray2);color:var(--white);padding:14px 18px;font-family:'DM Sans',sans-serif;font-size:0.9rem;border-radius:2px;outline:none;transition:border-color 0.2s;width:100%; }
    input:focus { border-color:var(--yellow); }
    .btn { width:100%;background:var(--red);color:var(--white);border:none;padding:16px;font-family:'Syne',sans-serif;font-weight:700;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;border-radius:2px;cursor:pointer;margin-top:8px;transition:background 0.2s; }
    .btn:hover { background:#c41d15; }
    .error { background:rgba(232,35,26,0.1);border:1px solid rgba(232,35,26,0.3);color:var(--red);padding:12px 16px;border-radius:2px;font-size:0.85rem;margin-bottom:16px; }
    .bar { height:3px;background:linear-gradient(90deg,var(--red) 0%,var(--yellow) 33%,#3a9e2f 66%,#1a5bbf 100%);margin-bottom:48px; }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="bar"></div>
    <div class="login-logo"><span class="r">on</span>fire <span class="y">systems</span></div>
    <h1>Panel Admin</h1>
    <p class="sub">Acceso restringido al equipo OnFire.</p>
    {hasError && <div class="error">Credenciales incorrectas. Intenta de nuevo.</div>}
    <form method="POST" action="/api/auth/login">
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required placeholder="admin@onfiresystems.co" />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required placeholder="••••••••" />
      </div>
      <button type="submit" class="btn">Ingresar →</button>
    </form>
  </div>
</body>
</html>

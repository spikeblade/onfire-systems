---
import Layout from '../layouts/Layout.astro'
import { getPageContent, get } from '../lib/content'

const c = await getPageContent('contacto')
const info = (k: string) => get(c, 'info', k)
---
<Layout title="Contáctenos — OnFire Systems" page="contacto">
<style>
  .contact-main { padding: 100px 48px 120px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; align-items: start; }
  .contact-info { position: sticky; top: 120px; }
  .contact-intro { font-size: 1rem; line-height: 1.8; color: rgba(245,245,240,0.6); margin-bottom: 56px; max-width: 420px; }
  .contact-channels { display: flex; flex-direction: column; }
  .channel { display: grid; grid-template-columns: 48px 1fr; gap: 20px; align-items: start; padding: 28px 0; border-bottom: 1px solid var(--gray2); transition: padding-left 0.3s; }
  .channel:first-child { border-top: 1px solid var(--gray2); }
  .channel:hover { padding-left: 8px; }
  .channel-icon { width: 40px; height: 40px; border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
  .ch-email .channel-icon { background: rgba(232,35,26,0.12); }
  .ch-phone .channel-icon { background: rgba(245,168,0,0.12); }
  .ch-wa .channel-icon { background: rgba(58,158,47,0.12); }
  .ch-li .channel-icon { background: rgba(26,91,191,0.12); }
  .channel-label { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; margin-bottom: 4px; }
  .ch-email .channel-label { color: var(--red); }
  .ch-phone .channel-label { color: var(--yellow); }
  .ch-wa .channel-label { color: var(--green); }
  .ch-li .channel-label { color: var(--blue); }
  .channel-value { font-size: 1rem; font-weight: 400; color: var(--white); text-decoration: none; display: block; }
  .channel-value:hover { color: var(--yellow); }
  .channel-sub { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }
  .form-title { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 40px; }
  .form-title span { color: var(--yellow); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-full { grid-column: 1 / -1; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label { font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
  .form-input, .form-select, .form-textarea { background: var(--gray); border: 1px solid var(--gray2); color: var(--white); padding: 14px 18px; font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 300; border-radius: 2px; outline: none; transition: border-color 0.2s, background 0.2s; width: 100%; }
  .form-input::placeholder, .form-textarea::placeholder { color: var(--muted); }
  .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--yellow); background: #1e1e1e; }
  .form-select { appearance: none; cursor: none; }
  .form-select option { background: var(--gray); }
  .form-textarea { resize: vertical; min-height: 140px; line-height: 1.6; }
  .form-check { display: flex; align-items: flex-start; gap: 12px; margin-top: 8px; }
  .form-check input[type="checkbox"] { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; accent-color: var(--red); cursor: none; }
  .form-check label { font-size: 0.82rem; color: var(--muted); line-height: 1.5; cursor: none; }
  .btn-submit { width: 100%; background: var(--red); color: var(--white); border: none; padding: 18px 32px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.88rem; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 2px; cursor: none; transition: background 0.2s, transform 0.2s; margin-top: 8px; }
  .btn-submit:hover { background: #c41d15; transform: translateY(-2px); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .form-success { display: none; text-align: center; padding: 60px 40px; background: var(--gray); border-radius: 2px; }
  .form-success.visible { display: block; }
  .success-icon { font-size: 3rem; margin-bottom: 20px; display: block; }
  .success-title { font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--green); margin-bottom: 12px; }
  .success-body { font-size: 0.9rem; line-height: 1.7; color: var(--muted); }
  .form-error { background: rgba(232,35,26,0.1); border: 1px solid rgba(232,35,26,0.3); color: var(--red); padding: 12px 16px; border-radius: 2px; font-size: 0.85rem; margin-bottom: 16px; display: none; }
  .form-error.visible { display: block; }
  .location-section { padding: 0 48px 100px; }
  .location-card { background: var(--gray); padding: 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .location-title { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; margin-bottom: 16px; }
  .location-desc { font-size: 0.9rem; line-height: 1.75; color: var(--muted); }
  .location-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(26,91,191,0.12); color: var(--blue); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; padding: 8px 16px; border-radius: 2px; margin-top: 20px; }
  .location-map { background: var(--black); border: 1px solid var(--gray2); height: 200px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .map-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(26,91,191,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(26,91,191,0.1) 1px, transparent 1px); background-size: 30px 30px; }
  .map-pin { position: relative; z-index: 1; text-align: center; }
  .map-pin-icon { font-size: 2.5rem; animation: pulse 2s ease-in-out infinite; }
  .map-pin p { font-size: 0.75rem; color: var(--muted); margin-top: 8px; }
  @keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }
</style>

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="page-hero-accent" style="width:350px;height:350px;background:var(--blue);top:-120px;right:100px;"></div>
  <div class="page-hero-accent" style="width:200px;height:200px;background:var(--yellow);bottom:0;left:500px;"></div>
  <div class="page-hero-content">
    <p class="page-eyebrow" style="color:var(--blue)">{get(c,'hero','eyebrow') || 'Hablemos'}</p>
    <h1 class="page-title">{get(c,'hero','title_line1') || 'Cuéntanos'}<br>tu <span style="color:var(--yellow)">{get(c,'hero','title_line2') || 'reto.'}</span></h1>
    <p class="page-subtitle">{get(c,'hero','subtitle') || 'Sin compromiso. Una conversación de 30 minutos puede ser el punto de partida de una solución que cambie la forma en que opera tu empresa.'}</p>
  </div>
</section>

<div class="contact-main">
  <div class="contact-info reveal">
    <p class="contact-intro">{info('intro') || 'Puedes escribirnos, llamarnos o simplemente llenar el formulario y te respondemos en menos de 24 horas hábiles.'}</p>
    <div class="contact-channels">
      <div class="channel ch-email">
        <div class="channel-icon">✉️</div>
        <div>
          <p class="channel-label">Correo</p>
          <a href={`mailto:${info('email') || 'hola@onfiresystems.co'}`} class="channel-value">{info('email') || 'hola@onfiresystems.co'}</a>
          <p class="channel-sub">Respuesta en menos de 24h hábiles</p>
        </div>
      </div>
      <div class="channel ch-phone">
        <div class="channel-icon">📞</div>
        <div>
          <p class="channel-label">Teléfono</p>
          <a href={`tel:${info('phone_raw') || '+573001234567'}`} class="channel-value">{info('phone') || '+57 300 123 4567'}</a>
          <p class="channel-sub">Lunes a viernes, 8am – 6pm</p>
        </div>
      </div>
      <div class="channel ch-wa">
        <div class="channel-icon">💬</div>
        <div>
          <p class="channel-label">WhatsApp</p>
          <a href={`https://wa.me/${info('whatsapp_raw') || '573001234567'}`} class="channel-value" target="_blank">{info('whatsapp') || '+57 300 123 4567'}</a>
          <p class="channel-sub">Para consultas rápidas</p>
        </div>
      </div>
      <div class="channel ch-li">
        <div class="channel-icon">💼</div>
        <div>
          <p class="channel-label">LinkedIn</p>
          <a href={info('linkedin_url') || '#'} class="channel-value" target="_blank">OnFire Systems</a>
          <p class="channel-sub">Síguenos para novedades del sector</p>
        </div>
      </div>
    </div>
  </div>

  <div class="contact-form-wrap reveal">
    <h2 class="form-title">Escríbenos<br><span>directamente.</span></h2>
    <div class="form-error" id="formError">Ocurrió un error al enviar el mensaje. Intenta de nuevo.</div>
    <form id="contactForm">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Nombre *</label>
          <input type="text" name="name" class="form-input" placeholder="Tu nombre completo" required />
        </div>
        <div class="form-group">
          <label class="form-label">Empresa</label>
          <input type="text" name="company" class="form-input" placeholder="Nombre de tu empresa" />
        </div>
        <div class="form-group">
          <label class="form-label">Correo electrónico *</label>
          <input type="email" name="email" class="form-input" placeholder="tu@empresa.com" required />
        </div>
        <div class="form-group">
          <label class="form-label">Teléfono</label>
          <input type="tel" name="phone" class="form-input" placeholder="+57 300 000 0000" />
        </div>
        <div class="form-group form-full">
          <label class="form-label">¿En qué servicio estás interesado? *</label>
          <select name="service" class="form-select form-input" required>
            <option value="" disabled selected>Selecciona un servicio</option>
            <option>Infraestructura (servidores, directorio activo, data center)</option>
            <option>Seguridad perimetral y redes</option>
            <option>Arquitectura de software</option>
            <option>Software a la medida</option>
            <option>Domótica e IoT</option>
            <option>Varios / No estoy seguro aún</option>
          </select>
        </div>
        <div class="form-group form-full">
          <label class="form-label">Cuéntanos tu reto o proyecto *</label>
          <textarea name="message" class="form-textarea" placeholder="Describe brevemente qué necesitas, cuál es el problema que quieres resolver o en qué etapa está tu proyecto..." required></textarea>
        </div>
        <div class="form-group form-full">
          <label class="form-label">¿En qué plazo necesitas la solución?</label>
          <select name="timeline" class="form-select form-input">
            <option value="" disabled selected>Selecciona un plazo aproximado</option>
            <option>Urgente (menos de 1 mes)</option>
            <option>Corto plazo (1–3 meses)</option>
            <option>Mediano plazo (3–6 meses)</option>
            <option>Aún no lo sé / estoy explorando</option>
          </select>
        </div>
        <div class="form-check form-full">
          <input type="checkbox" id="terms" required />
          <label for="terms">Acepto que OnFire Systems use esta información para contactarme con el propósito de responder mi consulta.</label>
        </div>
        <div class="form-full">
          <button type="submit" class="btn-submit" id="submitBtn">Enviar mensaje →</button>
        </div>
      </div>
    </form>
    <div class="form-success" id="formSuccess">
      <span class="success-icon">🔥</span>
      <p class="success-title">¡Mensaje recibido!</p>
      <p class="success-body">Gracias por escribirnos. Un miembro de nuestro equipo revisará tu consulta y te responderá en menos de 24 horas hábiles.</p>
    </div>
  </div>
</div>

<div class="location-section">
  <div class="location-card reveal">
    <div>
      <div class="section-tag">Dónde estamos</div>
      <h3 class="location-title">Colombia, con alcance nacional.</h3>
      <p class="location-desc">Operamos principalmente desde Colombia y atendemos clientes en todo el territorio nacional. Para proyectos de infraestructura física nos desplazamos según el alcance del proyecto.</p>
      <span class="location-badge">🇨🇴 Colombia</span>
    </div>
    <div class="location-map">
      <div class="map-grid"></div>
      <div class="map-pin"><div class="map-pin-icon">📍</div><p>Colombia</p></div>
    </div>
  </div>
</div>

<script>
const form = document.getElementById('contactForm') as HTMLFormElement
const success = document.getElementById('formSuccess')!
const errorBox = document.getElementById('formError')!
const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement

form.addEventListener('submit', async (e) => {
  e.preventDefault()
  errorBox.classList.remove('visible')
  submitBtn.disabled = true
  submitBtn.textContent = 'Enviando...'

  const data = Object.fromEntries(new FormData(form))
  try {
    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    if (res.ok) {
      form.style.display = 'none'
      success.classList.add('visible')
    } else {
      throw new Error()
    }
  } catch {
    errorBox.classList.add('visible')
    submitBtn.disabled = false
    submitBtn.textContent = 'Enviar mensaje →'
  }
})
</script>
</Layout>
